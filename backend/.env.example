# Local development: mongodb://localhost:27017/cinemax
# Vercel: use a hosted MongoDB connection string.
MONGO_URL=mongodb+srv://username:password@cluster.example.mongodb.net/cinemax?retryWrites=true&w=majority
PORT=8080
ACCESS_TOKEN=replace_with_a_long_random_secret
REFRESH_TOKEN=replace_with_a_different_long_random_secret
# Comma-separated frontend origins. Do not include a trailing slash.
CLIENT_URLS=http://localhost:5173,https://your-frontend.vercel.app
NODE_ENV=development

# Optional email configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
