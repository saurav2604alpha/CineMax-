# Required in the Vercel frontend project. Do not include a trailing slash.
VITE_API_URL=https://your-backend.vercel.app

# Optional for a long-running backend that hosts Socket.IO.
VITE_SOCKET_URL=https://your-backend.vercel.app
# Keep false for the current Vercel Express handler; use true for the local Node server.
VITE_ENABLE_REALTIME=false
